// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Chat {
  id           String    @id @default(cuid())
  title        String
  userId       String
  clientId     String    // Required client association for this chat
  contextFields String[] @default([]) // Array of context field names that were selected for this chat
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  messages     Message[]

  // Relations
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("chats")
}

model Message {
  id        String   @id @default(cuid())
  content   String
  role      Role
  chatId    String
  createdAt DateTime @default(now())

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@map("messages")
}

model Client {
  id          String   @id @default(cuid())
  userId      String   // The coach's user ID
  name        String
  email       String?
  phone       String?
  dateOfBirth DateTime?
  height      Float?   // in centimeters
  weight      Float?   // in kilograms
  country     String?  // Client's country/location
  goals       String?  // Health and fitness goals
  medicalHistory String? // Medical conditions, allergies, etc.
  notes       String?  // General notes about the client
  documentsLanguage String @default("english") // Preferred language for generated documents
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  chats       Chat[]
  documents   Document[]

  @@map("clients")
}

model Document {
  id          String   @id @default(cuid())
  userId      String   // The coach's user ID
  clientId    String   // The client this document belongs to
  documentName String  // The name of the document
  documentPath String  // Path in Supabase storage: user_id/client_id/document_name.md
  documentType String  // Type of document (e.g., "diet", "workout", "plan")
  startDate   DateTime? // For time-based documents like diets
  endDate     DateTime? // For time-based documents like diets
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("documents")
}

model Feedback {
  id          String   @id @default(cuid())
  userId      String   // The user's ID from Clerk
  userEmail   String?  // User's email for contact purposes
  userName    String?  // User's name
  type        String   // Type of feedback: "feature", "bug", "complaint"
  title       String   // Title of the feedback
  description String   // Detailed description of the feedback
  priority    String   // Priority level: "low", "medium", "high"
  useCase     String?  // Use case or scenario (for feature requests)
  stepsToReproduce String? // Steps to reproduce (for bug reports)
  createdAt   DateTime @default(now())
  
  @@map("feedbacks")
}

model Prompt {
  id          String   @id @default(cuid())
  userId      String   // The user's ID from Clerk
  name        String   // User-friendly name for the prompt
  description String?  // Optional description of what the prompt does
  content     String   // The actual prompt content/template
  category    String   @default("general") // Category for organization (general, medical, fitness, etc.)
  isActive    Boolean  @default(true) // Allow users to disable prompts without deleting
  usageCount  Int      @default(0) // Track how often prompt is used
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@map("prompts")
}

enum Role {
  USER
  ASSISTANT
}
