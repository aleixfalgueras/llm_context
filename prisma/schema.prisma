generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Chat {
  id            String    @id @default(cuid())
  title         String
  userId        String
  clientId      String?
  contextFields String[]  @default([])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  client        Client?   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  messages      Message[]

  @@map("chats")
}

model Message {
  id           String   @id @default(cuid())
  content      String
  role         Role
  model        String?
  tokensUsed   Int      @default(0)
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  chatId       String
  createdAt    DateTime @default(now())
  chat         Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@map("messages")
}

model Client {
  id                String     @id @default(cuid())
  userId            String
  name              String
  email             String?
  phone             String?
  country           String?
  generalContext    String?
  specificContext1  String?
  specificContext2  String?
  specificContext3  String?
  documentsLanguage String     @default("english")
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  chats             Chat[]
  documents         Document[]

  @@index([userId])
  @@map("clients")
}

model Document {
  id           String       @id @default(cuid())
  userId       String
  clientId     String
  documentName String
  documentPath String
  documentType DocumentType
  fileSize     Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("documents")
}

model Feedback {
  id               String   @id @default(cuid())
  userId           String
  userEmail        String?
  userName         String?
  type             String
  title            String
  description      String
  priority         String
  state            String   @default("PENDING")
  useCase          String?
  stepsToReproduce String?
  createdAt        DateTime @default(now())

  @@index([userId])
  @@map("feedbacks")
}

model Prompt {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  content     String
  category    String   @default("general")
  isActive    Boolean  @default(true)
  usageCount  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@map("prompts")
}

model UserSubscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  plan                 SubscriptionPlan   @default(apprentice)
  status               SubscriptionStatus @default(active)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  stripePriceId        String?
  currentPeriodStart   DateTime           @default(now())
  currentPeriodEnd     DateTime           @default(now())
  cancelAtPeriodEnd    Boolean            @default(false)
  pendingPlanChange    String?
  stripeScheduleId     String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  canceledAt           DateTime?
  tokenLimit           Int                @default(100000)

  @@index([currentPeriodEnd])
  @@map("user_subscriptions")
}

model UserUsage {
  id                 String   @id @default(cuid())
  userId             String
  billingPeriodStart DateTime
  billingPeriodEnd   DateTime
  tokensUsed         Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([userId, billingPeriodStart, billingPeriodEnd])
  @@index([userId])
  @@index([billingPeriodStart, billingPeriodEnd])
  @@map("user_usage")
}

model UserConsent {
  id                String    @id @default(cuid())
  userId            String    @unique
  dataProcessing    Boolean   @default(false)
  analytics         Boolean   @default(false)
  marketing         Boolean   @default(false)
  agreedToTerms     Boolean   @default(false)
  agreedToPrivacy   Boolean   @default(false)
  termsVersion      String?
  privacyVersion    String?
  cookiesNecessary  Boolean   @default(true)
  cookiesAnalytics  Boolean   @default(false)
  cookiesMarketing  Boolean   @default(false)
  cookiesFunctional Boolean   @default(false)
  ipAddress         String?
  userAgent         String?
  consentMethod     String?
  consentGivenAt    DateTime  @default(now())
  lastUpdatedAt     DateTime  @updatedAt
  withdrawnAt       DateTime?

  @@map("user_consents")
}

model ConsentAuditLog {
  id            String   @id @default(cuid())
  userId        String
  action        String
  consentType   String
  previousValue Boolean?
  newValue      Boolean
  reason        String?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())

  @@index([userId])
  @@map("consent_audit_logs")
}

model WebhookEvent {
  id            String    @id @default(cuid())
  stripeEventId String    @unique
  eventType     String
  processed     Boolean   @default(false)
  processedAt   DateTime?
  createdAt     DateTime  @default(now())

  @@index([stripeEventId])
  @@map("webhook_events")
}

model AccountDeletionRequest {
  id          String    @id @default(cuid())
  userId      String
  requestData Json?
  reason      String?
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@map("account_deletion_requests")
}

enum SubscriptionPlan {
  apprentice
  knight
  master
  jedi
}

enum SubscriptionStatus {
  active
  canceled
  past_due
  incomplete
  unpaid
}

enum Role {
  USER
  ASSISTANT
}

enum DocumentType {
  meeting
  custom_document
  manual
  chat
}
