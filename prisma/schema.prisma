// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Chat {
  id           String    @id @default(cuid())
  title        String
  userId       String
  clientId     String    // Required client association for this chat
  contextFields String[] @default([]) // Array of context field names that were selected for this chat
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  messages     Message[]

  // Relations
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("chats")
}

model Message {
  id        String   @id @default(cuid())
  content   String
  role      Role
  model     String?  // AI model used for this message (e.g., 'gpt-4o', 'gpt-4o-mini', 'claude-3-5-haiku')
  tokensUsed Int     @default(0) // Number of tokens consumed for this message (total)
  inputTokens Int    @default(0) // Number of input tokens for this message
  outputTokens Int   @default(0) // Number of output tokens for this message
  chatId    String
  createdAt DateTime @default(now())

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@map("messages")
}

model Client {
  id          String   @id @default(cuid())
  userId      String   // The marketing service provider's user ID
  name        String
  email       String?
  phone       String?
  country     String?  // Client's country/location

  generalContext String?  // General context about the client
  specifiContext1 String? // Specific context 1 about the client
  specifiContext2 String? // Specific context 2 about the client  
  specifiContext3 String? // Specific context 3 about the client
  documentsLanguage String @default("english") // Preferred language for generated documents
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  chats       Chat[]
  documents   Document[]

  @@map("clients")
}

model Document {
  id          String   @id @default(cuid())
  userId      String   // The marketing professional's user ID
  clientId    String   // The client this document belongs to
  documentName String  // The name of the document
  documentPath String  // Path in Supabase storage: user_id/client_id/document_name.md
  documentType String  // Type of document (e.g., "meeting-report", "custom-document", "proposal")
  startDate   DateTime? // For time-based documents like campaigns
  endDate     DateTime? // For time-based documents like campaigns
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("documents")
}

model Feedback {
  id          String   @id @default(cuid())
  userId      String   // The user's ID from Clerk
  userEmail   String?  // User's email for contact purposes
  userName    String?  // User's name
  type        String   // Type of feedback: "feature", "bug", "complaint"
  title       String   // Title of the feedback
  description String   // Detailed description of the feedback
  priority    String   // Priority level: "low", "medium", "high"
  useCase     String?  // Use case or scenario (for feature requests)
  stepsToReproduce String? // Steps to reproduce (for bug reports)
  createdAt   DateTime @default(now())
  
  @@map("feedbacks")
}

model Prompt {
  id          String   @id @default(cuid())
  userId      String   // The user's ID from Clerk
  name        String   // User-friendly name for the prompt
  description String?  // Optional description of what the prompt does
  content     String   // The actual prompt content/template
  category    String   @default("general") // Category for organization (general, marketing, content, etc.)
  isActive    Boolean  @default(true) // Allow users to disable prompts without deleting
  usageCount  Int      @default(0) // Track how often prompt is used
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@map("prompts")
}

// Enums for better type safety
enum SubscriptionPlan {
  basic
  pro
  business
}

enum SubscriptionStatus {
  active
  canceled
  past_due
  incomplete
}

// NEW: User Subscription Management
model UserSubscription {
  id              String   @id @default(cuid())
  userId          String   @unique // The user's ID from Clerk
  
  // Subscription Details
  plan            SubscriptionPlan   @default(basic)
  status          SubscriptionStatus @default(active)
  
  // Billing Information
  stripeCustomerId     String?  // Stripe customer ID
  stripeSubscriptionId String?  // Stripe subscription ID
  stripePriceId        String?  // Stripe price ID for current plan
  
  // Plan Limits
  maxClients              Int @default(3)     // Basic: 3, Pro: unlimited (-1), Business: unlimited (-1)
  maxTokensPerMonth       Int @default(100000) // Basic: 100K, Pro: 2M, Business: 4M
  
  // Billing Cycle
  currentPeriodStart DateTime @default(now())
  currentPeriodEnd   DateTime @default(now())
  
  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  canceledAt DateTime?
  
  @@map("user_subscriptions")
}

// NEW: Usage Tracking
model UserUsage {
  id       String @id @default(cuid())
  userId   String // The user's ID from Clerk
  
  // Usage Period (monthly tracking)
  year     Int
  month    Int
  
  // Token Tracking (primary limit with OpenRouter)
  tokensUsed        Int   @default(0)   // Total tokens consumed this month
  
  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Unique constraint for user per month
  @@unique([userId, year, month])
  @@map("user_usage")
}

model UserConsent {
  id              String   @id @default(cuid())
  userId          String   @unique // The user's ID from Clerk
  
  // GDPR Consent Fields
  dataProcessing  Boolean  @default(false) // Required for service
  analytics       Boolean  @default(false) // Optional - for analytics
  marketing       Boolean  @default(false) // Optional - for marketing communications
  
  // Legal Agreement Fields
  agreedToTerms   Boolean  @default(false) // Terms of Service agreement
  agreedToPrivacy Boolean  @default(false) // Privacy Policy agreement
  termsVersion    String?  // Version of terms they agreed to
  privacyVersion  String?  // Version of privacy policy they agreed to
  
  // Cookie Consent Fields
  cookiesNecessary  Boolean @default(true)  // Always true
  cookiesAnalytics  Boolean @default(false) // Optional
  cookiesMarketing  Boolean @default(false) // Optional
  cookiesFunctional Boolean @default(false) // Optional
  
  // Metadata
  ipAddress       String?  // IP when consent was given (for audit)
  userAgent       String?  // User agent when consent was given
  consentMethod   String?  // How consent was obtained (banner, form, etc.)
  
  // Timestamps
  consentGivenAt  DateTime @default(now())
  lastUpdatedAt   DateTime @updatedAt
  withdrawnAt     DateTime? // If consent was withdrawn
  
  @@map("user_consents")
}

model ConsentAuditLog {
  id            String   @id @default(cuid())
  userId        String   // The user's ID from Clerk
  action        String   // 'granted', 'updated', 'withdrawn'
  consentType   String   // 'data_processing', 'analytics', 'marketing', 'cookies'
  previousValue Boolean? // Previous consent state
  newValue      Boolean  // New consent state
  reason        String?  // Reason for change (user_request, policy_update, etc.)
  ipAddress     String?  // IP address when change occurred
  userAgent     String?  // User agent when change occurred
  createdAt     DateTime @default(now())
  
  @@map("consent_audit_logs")
}

model DataExportRequest {
  id          String   @id @default(cuid())
  userId      String   // The user's ID from Clerk
  requestType String   // 'full_export', 'specific_data', 'deletion_confirmation', 'account_deletion'
  status      String   // 'pending', 'processing', 'completed', 'failed', 'cancelled'
  requestData Json?    // Additional request parameters
  filePath    String?  // Path to generated export file
  expiresAt   DateTime? // When the export link expires
  completedAt DateTime? // When the export was completed
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@map("data_export_requests")
}

enum Role {
  USER
  ASSISTANT
}
