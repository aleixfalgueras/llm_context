generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Chat {
  id            String    @id @default(cuid())
  title         String
  userId        String
  clientId      String?
  contextFields String[]  @default([])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  client        Client?   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  messages      Message[]

  @@map("chats")
}

model Message {
  id               String   @id @default(cuid())
  content          String
  role             Role
  model            String?
  cost_usd         Float    @default(0)
  generation_id    String?
  images           Json?    // Store array of image URLs (base64 or external URLs)
  isPartialMessage Boolean  @default(false)
  isActive         Boolean  @default(true)
  chatId           String
  createdAt        DateTime @default(now())
  chat             Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([generation_id])
  @@map("messages")
}

model Client {
  id                String     @id @default(cuid())
  userId            String
  name              String
  email             String?
  phone             String?
  country           String?
  generalContext    String?
  specificContext1  String?
  specificContext2  String?
  specificContext3  String?
  documentsLanguage String     @default("en")
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  chats             Chat[]
  documents         Document[]

  @@index([userId])
  @@map("clients")
}

model Document {
  id           String       @id @default(cuid())
  userId       String
  clientId     String?
  documentName String
  documentPath String
  documentType DocumentType
  fileSize     Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  client       Client?      @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("documents")
}

model Feedback {
  id               String           @id @default(cuid())
  userId           String
  userEmail        String?
  userName         String?
  type             FeedbackType
  title            String
  description      String
  priority         FeedbackPriority
  state            FeedbackState    @default(PENDING)
  useCase          String?
  stepsToReproduce String?
  createdAt        DateTime         @default(now())

  @@index([userId])
  @@map("feedbacks")
}

model Prompt {
  id          String          @id @default(cuid())
  userId      String
  name        String
  description String?
  content     String
  category    PromptCategory  @default(general)
  isActive    Boolean         @default(true)
  usageCount  Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([userId])
  @@map("prompts")
}

model UserSubscription {
  id                        String             @id @default(cuid())
  userId                    String             @unique
  email                     String?
  plan                      SubscriptionPlan   @default(apprentice)
  status                    SubscriptionStatus @default(active)
  billingInterval           BillingInterval    @default(monthly)
  stripeCustomerId          String?
  stripeSubscriptionId      String?
  stripePriceId             String?
  currentPeriodStart        DateTime           @default(now())
  currentPeriodEnd          DateTime           @default(now())
  cancelAtPeriodEnd         Boolean            @default(false)
  pendingPlanChange         String?
  stripeScheduleId          String?
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt
  canceledAt                DateTime?
  spending_limit_usd        Float              @default(5.8)
  custom_spending_limit_usd Float? // Custom spending limit override for specific users

  @@index([currentPeriodEnd])
  @@map("user_subscriptions")
}

model UserUsage {
  id                 String   @id @default(cuid())
  userId             String
  billingPeriodStart DateTime
  billingPeriodEnd   DateTime
  cost_usd           Float    @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([userId, billingPeriodStart, billingPeriodEnd])
  @@index([userId])
  @@index([billingPeriodStart, billingPeriodEnd])
  @@index([cost_usd])
  @@map("user_usage")
}

model UserConsent {
  id                String    @id @default(cuid())
  userId            String    @unique
  dataProcessing    Boolean   @default(false)
  analytics         Boolean   @default(false)
  marketing         Boolean   @default(false)
  agreedToTerms     Boolean   @default(false)
  agreedToPrivacy   Boolean   @default(false)
  termsVersion      String?
  privacyVersion    String?
  cookiesNecessary  Boolean   @default(true)
  cookiesAnalytics  Boolean   @default(false)
  cookiesMarketing  Boolean   @default(false)
  cookiesFunctional Boolean   @default(false)
  ipAddress         String?
  userAgent         String?
  consentMethod     String?
  consentGivenAt    DateTime  @default(now())
  lastUpdatedAt     DateTime  @updatedAt
  withdrawnAt       DateTime?

  @@map("user_consents")
}

model ConsentAuditLog {
  id            String   @id @default(cuid())
  userId        String
  action        String
  consentType   String
  previousValue Boolean?
  newValue      Boolean
  reason        String?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())

  @@index([userId])
  @@map("consent_audit_logs")
}

model WebhookEvent {
  id            String    @id @default(cuid())
  stripeEventId String    @unique
  eventType     String
  processed     Boolean   @default(false)
  processedAt   DateTime?
  createdAt     DateTime  @default(now())

  @@index([stripeEventId])
  @@map("webhook_events")
}

model AccountDeletionRequest {
  id          String   @id @default(cuid())
  userId      String
  requestData Json?
  reason      String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@map("account_deletion_requests")
}

model Affiliation {
  id                    String            @id @default(cuid())
  userId                String            @unique
  affiliationCode       String            @unique
  parentAffiliationCode String?
  publicName            String?
  status                AffiliationStatus @default(GenY)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([userId])
  @@index([parentAffiliationCode])
  @@map("affiliations")
}

model Deal {
  id          String       @id @default(cuid())
  userId      String
  title       String
  description String       @db.Text
  price       String
  category    DealCategory @default(COLIVING)
  externalUrl String
  imageUrl    String?
  logoUrl     String?
  validFrom   DateTime?
  validUntil  DateTime?
  isActive    Boolean      @default(true)
  isApproved  Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([userId])
  @@index([isActive, isApproved])
  @@map("deals")
}

enum DealCategory {
  CONFERENCE
  ONLINE_COURSE
  ONLINE_CONSULTANCY
  GROUP_COACHING
  COLIVING
  COWORKING
  RETREAT
  HOTELS
  MASTERMIND
  RESTAURANT
  TRANSPORTATION
}

enum SubscriptionPlan {
  apprentice
  knight
  master
  jedi
}

enum SubscriptionStatus {
  active
  canceled
  past_due
  incomplete
  unpaid
}

enum BillingInterval {
  monthly
  annual
}

enum Role {
  USER
  ASSISTANT
}

enum DocumentType {
  meeting
  custom_document
  manual
  chat
}

enum AffiliationStatus {
  GenY
  Indigo
  LightWorker
  CristalClub
  D5Level
  Walkin
  SevenStars
  InfinityStars
  Alpha
  Omega
}

enum FeedbackType {
  feature
  bug
  complaint
}

enum FeedbackPriority {
  low
  medium
  high
}

enum FeedbackState {
  PENDING
  IN_PROGRESS
  COMPLETED
  FALSE_ALARM
}

enum PromptCategory {
  general
  marketing
  content
  analysis
}

enum DynamicTextCategory {
  subscription_features
}

model DynamicText {
  id           String              @id @default(cuid())
  key          String
  languageCode String
  value        String              @db.Text
  category     DynamicTextCategory
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@unique([key, languageCode])
  @@index([key])
  @@index([category])
  @@map("dynamic_texts")
}
